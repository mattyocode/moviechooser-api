# syntax=docker/dockerfile:1

# Stages:
#   base         shared Python image and env; no apt packages
#   builder      main dependencies in /opt/venv, embedding model in /opt/fastembed
#   builder-dev  builder plus the dev dependencies (pytest, flake8, black, isort)
#   runtime      the pushed image: venv, model and source, runs as `app`
#   test         runtime plus the dev venv; CI runs its checks here

FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod \
    DEBUG=0 \
    FASTEMBED_CACHE_PATH=/opt/fastembed \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app


FROM base AS builder

# Poetry lives in its own venv so it never reaches the runtime image. With
# virtualenvs.create off and VIRTUAL_ENV set, it installs into /opt/venv.
ENV POETRY_VERSION=2.5.1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1
RUN python -m venv /opt/venv \
    && python -m venv /opt/poetry \
    && /opt/poetry/bin/pip install "poetry==$POETRY_VERSION"

COPY poetry.lock pyproject.toml ./
RUN /opt/poetry/bin/poetry install --only main --no-root --no-interaction --no-ansi

# Bake the plot embedding model in, so containers never download it.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/fastembed')"


FROM builder AS builder-dev

RUN /opt/poetry/bin/poetry install --with dev --no-root --no-interaction --no-ansi


FROM base AS runtime

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/fastembed /opt/fastembed
COPY --chown=app:app . .
# /app itself stays root-owned, so create fetch_plots' default cache dir for
# app. Prod mounts a named volume here; it takes this ownership when created.
RUN mkdir -p /app/.plot_cache && chown app:app /app/.plot_cache
# Keep the entrypoint executable even if the checkout lost its exec bit.
RUN chmod 755 /app/entrypoint.prod.sh

# Throwaway values: collectstatic only needs settings to load. Real config is
# passed at run time.
RUN SECRET_KEY=collectstatic-only DJANGO_ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput

USER app

ENTRYPOINT ["/app/entrypoint.prod.sh"]


FROM runtime AS test

USER root
COPY --from=builder-dev /opt/venv /opt/venv
